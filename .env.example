# Template only. No .env file is loaded automatically.
# Set these in your shell or use a trusted environment-file loader.
SECRET_KEY=replace-with-a-new-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Local development only; production/Preview require PostgreSQL and DEBUG=False.
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL template: postgresql://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
# Use a dedicated non-production database for Preview. Never reuse production data.
